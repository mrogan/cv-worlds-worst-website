{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!.release-please-manifest.json", "!**/*.md", "!**/*.yaml", "!**/*.yml"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@openfeature/*", "@openfeature/**"],
                "message": "Only the flag context, src/flags/, asks OpenFeature: ask it whether a flag is on, with request.flag()."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/flags/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
